SECRET_KEY=cambia-esto-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# sigtic_db (PostgreSQL 15 — base principal)
SIGTIC_DB_NAME=sigtic_db
SIGTIC_DB_USER=sigtic
SIGTIC_DB_PASSWORD=
SIGTIC_DB_HOST=localhost
SIGTIC_DB_PORT=5432

# bdsiggo (PostgreSQL ~8.x — solo lectura, sistema legado siggo)
SIGGO_DB_NAME=bdsiggo
SIGGO_DB_USER=
SIGGO_DB_PASSWORD=
SIGGO_DB_HOST=
SIGGO_DB_PORT=5432

# Algoritmo de password de bdsiggo: md5 | sha1 | bcrypt
SIGGO_PASSWORD_ALGO=md5

# CORS — origins del frontend Angular (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# JWT cookie
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
